{
  "_help": "Edit this file. 'boards' pull from job aggregators (no company list needed). 'companies' is OPTIONAL: add Greenhouse/Lever/Ashby slugs only if you want to watch specific companies (slug = part after the domain in the job-board URL).",
  "boards": {
    "remotive": true,
    "remoteok": true,
    "arbeitnow": false
  },
  "companies": {
    "greenhouse": [],
    "lever": [],
    "lever_eu": [],
    "ashby": []
  },
  "filters": {
    "title_include": [
      "frontend",
      "front-end",
      "front end",
      "full-stack",
      "fullstack",
      "full stack",
      "react",
      "mern",
      "web developer",
      "software engineer",
      "developer",
      "engineer",
      "js",
      "javascript",
      "typescript",
      "junior",
      "entry level",
      "entry-level"
    ],
    "title_exclude": [
      "director",
      "vp ",
      "vice president",
      "head of",
      "principal",
      "recruiter",
      "sales",
      "marketing",
      "designer",
      "manager",
      "devops",
      "android",
      "ios",
      "senior",
      "lead",
      "staff",
      "architect",
      "sr",
      "sr.",
      "mid-senior",
      "qa",
      "automation",
      "java",
      "angular",
      "dotnet",
      ".net"
    ],
    "stack_keywords": [
      "react",
      "typescript",
      "javascript",
      "node",
      "next.js",
      "express",
      "mongodb",
      "mongoose",
      "redux",
      "tailwind",
      "redis",
      "vite"
    ],
    "min_stack_hits": 2,
    "company_exclude": [],
    "company_priority": [],
    "require_remote": true,
    "location_exclude_terms": [
      "united states",
      "usa",
      "u.s.",
      "us only",
      "us-only",
      "canada",
      "north america",
      "remote - us",
      "remote, us"
    ],
    "location_allow_terms": [
      "worldwide",
      "global",
      "anywhere",
      "emea",
      "europe",
      "africa",
      "middle east",
      "apac",
      "international"
    ],
    "max_age_days": 14
  },
  "limits": {
    "max_candidates_per_run": 30,
    "description_max_chars": 7000,
    "max_messages": 15,
    "seen_retention_days": 90
  },
  "score_threshold": 75,
  "llm": {
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "model": "gemini-3.5-flash-lite",
    "num_ctx": 32768,
    "temperature": 0,
    "keep_alive": "30m",
    "timeout": 600,
    "think": false,
    "provider": "openai",
    "api_key_env": "LLM_API_KEY",
    "max_output_tokens": 2500,
    "json_mode": "schema",
    "request_delay": 5,
    "extra_body": {
      "reasoning_effort": "low"
    }
  },
  "telegram": {
    "link_preview": false,
    "notify_on_empty": true
  }
