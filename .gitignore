# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.locks
logs

# Virtual environments
.venv

# Secrets and personal files
.env
config/*
!config/.gitkeep

# Generated by the tool. Only data/seen.json is meant to be committed (the GitHub Actions workflow does it).
data/*
!data/.gitkeep
!data/seen.json
