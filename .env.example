# Copy to .env (or run `python -m jobhunter init`) and fill in. NEVER commit or share .env.

# Telegram: create a bot with @BotFather for the token; message your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The AI API key. Only needed when llm.provider is "openai" (Gemini, OpenAI, OpenRouter, ...).
# The variable's name is configurable: config.json -> llm.api_key_env
LLM_API_KEY=
